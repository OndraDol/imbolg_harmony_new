{% macro image(media, first) %}
<figure data-media-id="{{ media.id }}">
  <a href="{{ media.full }}" aria-label="Zvětšit fotografii: {{ media.alt }}">
    <img src="{{ media.src }}" srcset="{{ media.srcset }}" sizes="(max-width: 48rem) 100vw, 48rem" width="{{ media.width }}" height="{{ media.height }}" alt="{{ media.alt }}" loading="{% if first %}eager{% else %}lazy{% endif %}" decoding="async">
  </a>
  {% if media.caption %}<figcaption>{{ media.caption }}</figcaption>{% endif %}
</figure>
{% endmacro %}
